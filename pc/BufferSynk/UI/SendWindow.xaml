<Window x:Class="BufferSynk.UI.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отправить в ZeroSynk"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="⇄" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Отправить на телефон" Style="{StaticResource H2}" FontSize="15"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Text="Выбранные файлы"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="CloseBtn" Click="OnCancel"
                        Width="30" Height="30" Padding="0" Margin="8,0,0,0"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        BorderThickness="0" Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="Закрыть">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <TextBlock x:Name="X" Text="✕" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBg}"/>
                                    <Setter TargetName="X" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- File list -->
            <Border Grid.Row="1" Background="{DynamicResource InputBg}" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="80">
                    <TextBlock x:Name="FileListText" Style="{StaticResource Body}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                </ScrollViewer>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Style="{StaticResource SecondaryButton}"
                        Content="Отмена" MinWidth="90" Margin="0,0,10,0" Click="OnCancel"/>
                <Button x:Name="SendBtn" Style="{StaticResource PrimaryButton}"
                        Content="Отправить" MinWidth="110" Click="OnSend"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
