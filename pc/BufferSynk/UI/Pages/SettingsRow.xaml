<UserControl x:Class="BufferSynk.UI.Pages.SettingsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderText" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"
                       FontWeight="Medium" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubText" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                       Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleButton x:Name="Switch" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                      VerticalAlignment="Center" Checked="OnChanged" Unchecked="OnChanged"/>
    </Grid>
</UserControl>
