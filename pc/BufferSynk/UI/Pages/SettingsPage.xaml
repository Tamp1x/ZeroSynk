<UserControl x:Class="BufferSynk.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:BufferSynk.UI.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Настройки" Style="{StaticResource H1}" Margin="0,0,0,20"/>

            <!-- Запуск -->
            <TextBlock Text="Запуск" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <pages:SettingsRow x:Name="RowAutoStart" Header="Запускать вместе с Windows"
                                Sub="Тихо стартовать в фоне при входе в систему"
                                Clicked="OnToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowStartMin" Header="Скрывать при запуске"
                                Sub="Не показывать окно, сразу в трее"
                                Clicked="OnToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowTray" Header="Иконка в трее"
                                Sub="Выключите — при закрытии окна программа завершится полностью"
                                Clicked="OnTrayToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowMinToTray" Header="Сворачивать в трей"
                                Sub="Кнопка «—» прячет окно вместо закрытия"
                                Clicked="OnToggle"/>
                </StackPanel>
            </Border>

            <!-- Синхронизация -->
            <TextBlock Text="Синхронизация" Style="{StaticResource SectionHeader}" Margin="4,12,0,8"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <pages:SettingsRow x:Name="RowSyncTo" Header="ПК → телефон"
                                Sub="Текст из буфера Windows уходит на телефон"
                                Clicked="OnToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowSyncFrom" Header="Телефон → ПК"
                                Sub="Текст с телефона вставляется в буфер Windows"
                                Clicked="OnToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowImages" Header="Картинки из буфера"
                                Sub="Синхронизировать изображения (до 3 МБ)"
                                Clicked="OnToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowSound" Header="Звук при получении файла"
                                Sub=""
                                Clicked="OnToggle"/>
                </StackPanel>
            </Border>

            <!-- Медиа и уведомления -->
            <TextBlock Text="Медиа и уведомления" Style="{StaticResource SectionHeader}" Margin="4,12,0,8"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <pages:SettingsRow x:Name="RowMediaToPhone" Header="Медиа-плеер на телефоне"
                                Sub="Показывать уведомление-плеер для музыки/видео на ПК (кнопки ⏮ ⏸ ⏭)"
                                Clicked="OnMediaNotifToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowMirrorPhone" Header="Уведомления телефона → ПК"
                                Sub="Зеркалить уведомления мессенджеров и других приложений на ПК"
                                Clicked="OnMediaNotifToggle"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowMirrorWin" Header="Уведомления Windows → телефон"
                                Sub="Показывать уведомления с ПК на телефоне (требуется разрешение Windows)"
                                Clicked="OnMediaNotifToggle"/>
                </StackPanel>
            </Border>

            <!-- Файлы -->
            <TextBlock Text="Файлы" Style="{StaticResource SectionHeader}" Margin="4,12,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Папка сохранения" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Grid.Column="0" Style="{StaticResource InputBox}"
                                 VerticalContentAlignment="Center" IsReadOnly="True" MinHeight="40"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Выбрать…"
                                Margin="10,0,0,0" Click="OnChooseFolder"/>
                    </Grid>
                    <pages:SettingsRow x:Name="RowAutoAccept" Header="Принимать файлы автоматически"
                                Sub="Без подтверждения сохранять в папку"
                                Clicked="OnToggle" Margin="0,12,0,0"/>
                    <Separator Style="{StaticResource SepStyle}"/>
                    <pages:SettingsRow x:Name="RowAutoClean" Header="Очищать старые файлы"
                                Sub="При получении новых файлов удалять предыдущие"
                                Clicked="OnToggle"/>
                </StackPanel>
            </Border>

            <!-- Порт -->
            <TextBlock Text="Сеть" Style="{StaticResource SectionHeader}" Margin="4,12,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Порт сервера" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            <TextBox x:Name="PortBox" Style="{StaticResource InputBox}" Width="110"
                                     HorizontalAlignment="Left" Margin="0,10,0,0"
                                     VerticalContentAlignment="Center" MaxLength="5" MinHeight="40"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Применить"
                                VerticalAlignment="Center" Click="OnApplyPort"/>
                    </Grid>
                    <TextBlock x:Name="PortHint" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Внешний вид -->
            <TextBlock Text="Внешний вид" Style="{StaticResource SectionHeader}" Margin="4,12,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Тема" Style="{StaticResource Body}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton x:Name="ThemeSystem" Content="Системная" Style="{StaticResource ThemeRadio}"
                                 Checked="OnThemeChanged" IsChecked="True"/>
                    <RadioButton x:Name="ThemeLight" Content="Светлая" Style="{StaticResource ThemeRadio}"
                                 Checked="OnThemeChanged"/>
                    <RadioButton x:Name="ThemeDark" Content="Тёмная" Style="{StaticResource ThemeRadio}"
                                 Checked="OnThemeChanged"/>
                </StackPanel>
            </Border>

            <!-- О программе -->
            <TextBlock Text="О программе" Style="{StaticResource SectionHeader}" Margin="4,12,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ZeroSynk 1.4.0" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Синхронизация буфера обмена и файлов по локальной сети/Tailscale. Трафик шифруется Tailscale, авторизация — токеном."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Копировать токен"
                                Click="OnCopyToken" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Сбросить пару"
                                Click="OnResetPair"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Height="8"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
