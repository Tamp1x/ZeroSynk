<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Onyx: near-black surfaces with a gold accent (#C9A227) -->
    <SolidColorBrush x:Key="BgBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#131109"/>
    <SolidColorBrush x:Key="CardBrush" Color="#17140D"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F6EFDF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A99E85"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6F6754"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C9A227"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#33C9A227"/>
    <SolidColorBrush x:Key="AccentText" Color="#171205"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#221C2E22"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF453A"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3427"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#18C9A227"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#30C9A227"/>
    <SolidColorBrush x:Key="NeutralSoft" Color="#242017"/>
    <SolidColorBrush x:Key="InputBg" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#3A3427"/>
    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#80C9A227"/>

    <!-- Thin gold card outline -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#33C9A227"/>
    <Thickness x:Key="CardBorderThickness">1</Thickness>

    <!-- Drag & drop overlay -->
    <SolidColorBrush x:Key="DropOverlayBrush" Color="#CCC9A227"/>
    <SolidColorBrush x:Key="DropOverlayText" Color="#171205"/>

</ResourceDictionary>
