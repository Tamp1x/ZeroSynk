<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Eclipx: eclipse — dark grey/black surfaces, white outlines, almost no bright colors -->
    <SolidColorBrush x:Key="BgBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#151515"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#7C7C7C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#221C2E22"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF453A"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#333333"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="NeutralSoft" Color="#262626"/>
    <SolidColorBrush x:Key="InputBg" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#666666"/>
    <SolidColorBrush x:Key="KnobBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#B3FFFFFF"/>

    <!-- White card outline ("sun behind the moon") -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#40FFFFFF"/>
    <Thickness x:Key="CardBorderThickness">1</Thickness>

    <!-- Drag & drop overlay -->
    <SolidColorBrush x:Key="DropOverlayBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="DropOverlayText" Color="#0D0D0D"/>

</ResourceDictionary>
