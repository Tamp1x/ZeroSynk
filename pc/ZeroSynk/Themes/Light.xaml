<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Apple-like light palette (mirrors the Android app) -->
    <SolidColorBrush x:Key="BgBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E8E8ED"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#8E8E93"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E5F0FF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#E7F8EE"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FF9500"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="NeutralSoft" Color="#F0F0F3"/>
    <SolidColorBrush x:Key="InputBg" Color="#0A000000"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#2E3C3C43"/>

    <!-- Card outline (visible only in skins that define it, e.g. Onyx/Eclipx) -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#00000000"/>
    <Thickness x:Key="CardBorderThickness">0</Thickness>

    <!-- Drag & drop overlay -->
    <SolidColorBrush x:Key="DropOverlayBrush" Color="#CC0A84FF"/>
    <SolidColorBrush x:Key="DropOverlayText" Color="#FFFFFFFF"/>

</ResourceDictionary>
