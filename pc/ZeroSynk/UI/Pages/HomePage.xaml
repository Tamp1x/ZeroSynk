<UserControl x:Class="ZeroSynk.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Главная" Style="{StaticResource H1}" Margin="0,0,0,20"/>

            <!-- Status card -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                            Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                        <TextBlock Text="⇄" FontSize="21" Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Ожидание подключения"
                                   Style="{StaticResource H2}"/>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Остановить"
                            VerticalAlignment="Center" Click="OnSyncToggle" x:Name="SyncToggleBtn"/>
                </Grid>
            </Border>

            <!-- Phone media card: what the phone plays right now, controlled from the PC -->
            <Border x:Name="PhoneMediaCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14"
                                Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                            <TextBlock Text="♪" FontSize="21" Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Играет на телефоне" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="PhoneMediaTitle" Text="—" Style="{StaticResource H2}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PhoneMediaSub" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="PhoneMediaProgress" Grid.Column="0" Height="6" Minimum="0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource NeutralSoft}"
                                     BorderThickness="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PhoneMediaTime" Grid.Column="1" Style="{StaticResource Caption}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="−10 с" Tag="seekBack"
                                Padding="12,8" Margin="0,0,8,0" Click="OnPhoneMediaCmd"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="⏮" Tag="prev"
                                Padding="12,8" Margin="0,0,8,0" Click="OnPhoneMediaCmd"/>
                        <Button x:Name="PhoneMediaToggle" Style="{StaticResource PrimaryButton}" Content="⏸"
                                Padding="16,8" Margin="0,0,8,0" Tag="toggle" Click="OnPhoneMediaCmd"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="⏭" Tag="next"
                                Padding="12,8" Margin="0,0,8,0" Click="OnPhoneMediaCmd"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="+10 с" Tag="seekFwd"
                                Padding="12,8" Click="OnPhoneMediaCmd"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Громкость −" Tag="volDown"
                                Padding="12,7" Margin="0,0,8,0" Click="OnPhoneMediaCmd"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Стоп" Tag="stop"
                                Padding="12,7" Margin="0,0,8,0" Click="OnPhoneMediaCmd"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Громкость +" Tag="volUp"
                                Padding="12,7" Click="OnPhoneMediaCmd"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pairing card -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource NeutralSoft}" CornerRadius="12" Padding="10">
                        <Image x:Name="QrImage" Width="148" Height="148"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,2,0,0">
                        <TextBlock Text="Подключите телефон" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="PairHint" Style="{StaticResource Caption}" Margin="0,6,0,0">
                            Откройте ZeroSynk на телефоне и отсканируйте QR-код.
                            Всё работает через вашу сеть (Tailscale в том числе).
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="PIN:" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PinText" Text="------" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="QrHintText" Style="{StaticResource Caption}" Margin="0,7,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Скопировать PIN"
                                    Click="OnCopyPin" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Новый код"
                                    Click="OnRegenPair"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Actions -->
            <TextBlock Text="Отправить" Style="{StaticResource SectionHeader}" Margin="4,6,0,8"/>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Button x:Name="SendFileBtn" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Padding="16,12"
                            Content="📎  Выбрать файлы…" Click="OnSendFileClick"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickText" Grid.Column="0" Style="{StaticResource InputBox}"
                                 VerticalContentAlignment="Center" MinHeight="40"
                                 Text="Текст для буфера телефона…"
                                 GotFocus="OnQuickTextFocus" LostFocus="OnQuickTextLostFocus"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="Отправить" Margin="10,0,0,0" Click="OnQuickTextSend"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Text="Можно перетаскивать файлы прямо в это окно. Текст и картинки из буфера обмена Windows синхронизируются автоматически."/>
                </StackPanel>
            </Border>

            <!-- Receive info -->
            <TextBlock Text="Приём файлов" Style="{StaticResource SectionHeader}" Margin="4,6,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="21"
                            Background="{DynamicResource GreenSoft}" VerticalAlignment="Top">
                        <TextBlock Text="↓" FontSize="19" Foreground="{DynamicResource GreenBrush}"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ReceiveDirText" Style="{StaticResource H2}" FontSize="15"
                                   Text="Файлы с телефона"/>
                        <TextBlock x:Name="ReceiveDirSub" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   Text="Сохраняются автоматически"/>
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="Открыть папку"
                            Margin="12,0,0,0" VerticalAlignment="Center" Click="OnOpenFolder"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
