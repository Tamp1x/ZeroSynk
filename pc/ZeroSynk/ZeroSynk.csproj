<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZeroSynk</AssemblyName>
    <RootNamespace>ZeroSynk</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <Product>ZeroSynk</Product>
    <Description>Clipboard and file sync between PC and phone over local network</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="..\ZeroSynk.ShellExtension\ZeroSynk.ShellExtension.csproj" />
  </ItemGroup>

  <Target Name="CopyShellExtensionComHost" AfterTargets="Build">
    <Copy SourceFiles="..\ZeroSynk.ShellExtension\bin\$(Configuration)\net8.0-windows\ZeroSynk.ShellExtension.comhost.dll;..\ZeroSynk.ShellExtension\bin\$(Configuration)\net8.0-windows\ZeroSynk.ShellExtension.deps.json;..\ZeroSynk.ShellExtension\bin\$(Configuration)\net8.0-windows\ZeroSynk.ShellExtension.runtimeconfig.json"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('..\ZeroSynk.ShellExtension\bin\$(Configuration)\net8.0-windows\ZeroSynk.ShellExtension.comhost.dll')" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon_onyx.ico" />
    <Resource Include="Assets\icon_eclipx.ico" />
  </ItemGroup>

</Project>
