<Window x:Class="ZeroSynk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroSynk"
        Width="1020" Height="680"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="False"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStyle="SingleBorderWindow"
        Closing="OnClosing">

    <Border x:Name="RootBorder" CornerRadius="10" ClipToBounds="True" Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <DockPanel Margin="14,18,14,14">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="⇄" Foreground="{DynamicResource AccentText}" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="LogoText" Text="ZeroSynk" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel DockPanel.Dock="Top">
                        <ToggleButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home"
                                      IsChecked="True" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" Width="22" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Главная" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="history"
                                      Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕘" Width="22" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="История" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavNotifs" Style="{StaticResource NavItem}" Tag="notifs"
                                      Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" Width="22" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Уведомления" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings"
                                      Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Width="22" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Footer status -->
                    <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom"
                            Background="{DynamicResource HoverBrush}" CornerRadius="12" Padding="12,11" Margin="2,0,2,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource OrangeBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="StatusText" Text="Ожидание подключения"
                                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="IpText" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ===== Content ===== -->
            <Grid Grid.Column="1">
                <!-- Drag & drop overlay -->
                <Border x:Name="DropOverlay" Visibility="Collapsed"
                        Background="{DynamicResource DropOverlayBrush}" Panel.ZIndex="100">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="↓" FontSize="54" Foreground="{DynamicResource DropOverlayText}" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Отпустите, чтобы отправить на телефон"
                                   FontSize="18" Foreground="{DynamicResource DropOverlayText}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="ContentHost"/>
            </Grid>
        </Grid>
    </Border>
</Window>
